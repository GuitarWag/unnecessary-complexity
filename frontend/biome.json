{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/gen/**",
      "**/@mf-types/**",
      "**/*.gen.ts",
      "**/*.pb.ts",
      "**/*_pb.ts",
      "**/*.d.ts",
      "**/coverage/**",
      "**/.turbo/**",
      "pnpm-lock.yaml"
    ]
  },
  "organizeImports": { "enabled": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn"
      },
      "complexity": {
        "noUselessConstructor": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  }
}
